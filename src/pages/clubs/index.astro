---
import ArrowLeftIcon from "heroicons/24/outline/arrow-left.svg"
import ArrowRightIcon from "heroicons/24/outline/arrow-right.svg"
import GlobeAltIcon from "heroicons/24/outline/globe-alt.svg"
import UsersIcon from "heroicons/24/outline/users.svg"
import BaseLayout from "@/layouts/BaseLayout.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import Footer from "@/components/Footer.astro"
import InstagramIcon from "@/components/icons/instagram.svg"
import Badge from "@/components/ui/Badge.astro"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import CardContent from "@/components/ui/CardContent.astro"
import CardFooter from "@/components/ui/CardFooter.astro"
import CardHeader from "@/components/ui/CardHeader.astro"
import CardTitle from "@/components/ui/CardTitle.astro"
import { getAllClubs, parseClubInstagram } from "@/lib/supabase"

const { success, clubs } = await getAllClubs()
const clubsData = success && clubs ? clubs : []
---

<BaseLayout>
  <div class="min-h-screen bg-background">
    <SiteHeader />
    
    <main class="container max-w-7xl mx-auto px-4 md:px-6 py-8">
      {/* Back Button */}
      <div class="mb-6">
        <Button href="/" variant="ghost" class="gap-2">
            <ArrowLeftIcon class="h-4 w-4" />
            Ana Sayfaya Dön
          </Button>
      </div>

      {/* Header */}
      <div class="flex flex-col items-center justify-center space-y-4 text-center mb-10">
        <h1 class="text-3xl font-bold tracking-tighter sm:text-4xl md:text-5xl">
          Tüm Kulüplerimiz
        </h1>
        <p class="max-w-3xl text-muted-foreground text-lg">
          Okuldaki tüm kulüpleri keşfedin ve ilginizi çeken alanlarda aktif olun.
        </p>
      </div>

      {/* Clubs Grid */}
      {clubsData.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {clubsData.map((club) => {
            const logoPath = club.logo || "/placeholder.svg"
            const instagrams = parseClubInstagram(club.instagram)
            
            return (
              <Card class="overflow-hidden hover:shadow-lg transition-shadow h-full">
                <div class="relative aspect-[4/3]">
                  <img src={logoPath}
                    alt={club.title || "Kulüp Logosu"} class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
                </div>
              <CardHeader class="pb-4">
                <div class="flex items-center gap-2 mb-2">
                  {club.code && (
                    <Badge variant="secondary" class="text-xs">
                      {club.code}
                    </Badge>
                  )}
                </div>
                <CardTitle class="line-clamp-2 text-lg">
                  {club.title || "Kulüp Adı"}
                </CardTitle>
              </CardHeader>
              <CardContent class="pb-4">
                <p class="text-muted-foreground line-clamp-3">
                  {club.description || "Kulüp açıklaması mevcut değil."}
                </p>
                
                {/* Contact info preview */}
                <div class="flex items-center gap-3 mt-3 text-sm text-muted-foreground">
                  {club.owners && (
                    <div class="flex items-center gap-1">
                      <UsersIcon class="h-3 w-3" />
                      <span class="truncate">{club.owners.split(',')[0]}</span>
                    </div>
                  )}
                  {instagrams.length > 0 && (
                    <div class="flex items-center gap-1">
                      <InstagramIcon class="h-3 w-3" />
                      <span class="truncate">@{instagrams[0].replace(/^@/, '')}</span>
                    </div>
                  )}
                  {club.urls && (
                    <GlobeAltIcon class="h-3 w-3" />
                  )}
                </div>
              </CardContent>
              <CardFooter class="pt-0">
                <Button href={`/clubs/${club.id}`} variant="outline" class="w-full">
                    Detayları Gör <ArrowRightIcon class="ml-2 h-4 w-4" />
                  </Button>
              </CardFooter>
            </Card>
            )
          })}
        </div>
      ) : (
        <div class="flex flex-col items-center justify-center py-16 text-center">
          <div class="rounded-full bg-muted p-6 mb-4">
            <UsersIcon class="h-12 w-12 text-muted-foreground" />
          </div>
          <h3 class="text-xl font-semibold mb-2">Henüz Kulüp Yok</h3>
          <p class="text-muted-foreground max-w-md">
            Şu anda hiç kulüp kaydedilmemiş. Yakında yeni kulüpler eklenecek.
          </p>
        </div>
      )}
      
    </main>
    <Footer/>
  </div>
</BaseLayout>
