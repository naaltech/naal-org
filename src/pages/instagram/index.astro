---
import ArrowLeftIcon from "heroicons/24/outline/arrow-left.svg"
import BaseLayout from "@/layouts/BaseLayout.astro"
import SiteHeader from "@/components/SiteHeader.astro"
import Footer from "@/components/Footer.astro"
import InstagramIcon from "@/components/icons/instagram.svg"
import InstagramPosts from "@/components/instagram/InstagramPosts.astro"

const sharedPostParam = Astro.url.searchParams.get("post")
---

<BaseLayout
  title="Instagram Paylaşımları - Nevzat Ayaz Etkileşim Ağı"
  description="Nevzat Ayaz Anadolu Lisesi kulüplerinin Instagram paylaşımları. Tüm kulüp güncellemelerini takip edin."
  keywords="instagram, kulüp paylaşımları, öğrenci içerikleri, sosyal medya, NAAL"
  ogDescription="Kulüplerden en güncel Instagram paylaşımları"
>
  <div class="flex min-h-screen flex-col">
    <SiteHeader />
    <main class="flex flex-1 flex-col">
      <div class="flex-1 py-12">
        <div class="container max-w-7xl mx-auto px-4 md:px-6">
          {/* Header Section */}
          <div class="mb-8">
            <div class="flex items-center gap-4 mb-6">
              <a href="/" class="text-muted-foreground hover:text-foreground">
                <ArrowLeftIcon class="h-5 w-5" />
              </a>
              <div class="flex items-center gap-3">
                <InstagramIcon class="h-8 w-8" style={{ color: '#2ea5d5' }} />
                <div>
                  <h1 class="text-3xl font-bold">Instagram Paylaşımları</h1>
                  <p class="text-muted-foreground">
                    Kulüplerimizden <span data-total-count>…</span> paylaşım
                  </p>
                </div>
              </div>
            </div>

            <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
              <a
                href="/instagram/accounts"
                class="inline-flex items-center gap-2 px-4 py-2 bg-black text-white rounded-full hover:bg-black/80 transition-all"
              >
                <InstagramIcon class="h-4 w-4" />
                Kulüp Instagram Hesapları
              </a>
              <a
                href="https://www.instagram.com/nevzatayazanadolulisesi_/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-4 py-2 bg-black text-white rounded-full hover:bg-black/80 transition-all"
              >
                <InstagramIcon class="h-4 w-4" />
                Resmi Instagram Hesabımız
              </a>
            </div>
          </div>

          {/* Posts Grid */}
          <InstagramPosts server:defer sharedPostParam={sharedPostParam}>
            <p slot="fallback" class="py-16 text-center text-muted-foreground">Yükleniyor...</p>
          </InstagramPosts>
        </div>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>

