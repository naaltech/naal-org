---
import ArrowTopRightOnSquareIcon from "heroicons/24/outline/arrow-top-right-on-square.svg"
import Button from "@/components/ui/Button.astro"
import Card from "@/components/ui/Card.astro"
import CardContent from "@/components/ui/CardContent.astro"
import CardHeader from "@/components/ui/CardHeader.astro"
import CardTitle from "@/components/ui/CardTitle.astro"

interface OfficialNews {
  baslik: string
  url: string
  kaynak: string
  yayinTarihi: string
}

interface NewsResponse {
  success: boolean
  count: number
  data: OfficialNews[]
}

// Haber servisi yavaşsa ana sayfa beklemesin
const NEWS_TIMEOUT = 3000

let news: OfficialNews[] = []

try {
  const response = await fetch('https://news.naal.org.tr/api/haberler?format=json', {
    signal: AbortSignal.timeout(NEWS_TIMEOUT),
  })
  const data: NewsResponse = await response.json()

  if (data.success) {
    // Son 6 haberi al
    news = data.data.slice(0, 6)
  }
} catch (error) {
  console.error('Haberler yüklenirken hata oluştu:', error)
}
---

<section class="w-full py-12 md:py-16 bg-muted/50">
  <div class="container max-w-7xl mx-auto px-4 md:px-6">
    <div class="text-center mb-8">
      <h2 class="text-2xl md:text-3xl font-bold mb-4">Okuldan Resmi Haberler</h2>
      <p class="text-muted-foreground max-w-2xl mx-auto">
        Nevzat Ayaz Anadolu Lisesi'nden en güncel haberler ve duyurular
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {news.map((item) => (
        <Card class="hover:shadow-lg transition-shadow duration-300 h-full flex flex-col">
          <CardHeader class="pb-3">
            <div class="flex items-start justify-between gap-2 mb-2">
              <span class="text-xs font-medium text-muted-foreground px-2 py-1 rounded-full" style={{ backgroundColor: '#cbebf7', color: '#226882' }}>
                Resmi Haber
              </span>
            </div>
            <CardTitle class="text-lg leading-tight line-clamp-3">
              {item.baslik}
            </CardTitle>
          </CardHeader>
          <CardContent class="pt-0 mt-auto">
            <div class="flex items-center justify-between">
              <span class="text-xs text-muted-foreground">
                {item.kaynak}
              </span>
              <Button href={item.url} target="_blank" rel="noopener noreferrer" variant="outline" size="sm" class="gap-1">
                Devamını Oku
                <ArrowTopRightOnSquareIcon class="h-3 w-3" />
              </Button>
            </div>
          </CardContent>
        </Card>
      ))}
    </div>

    {news.length === 0 && (
      <div class="text-center py-8">
        <p class="text-muted-foreground">Şu anda görüntülenecek haber bulunmuyor.</p>
      </div>
    )}
  </div>
</section>
